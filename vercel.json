{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/server",
  "public": "dist/client",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "env": {
    "VITE_SUPABASE_URL": "@VITE_SUPABASE_URL",
    "VITE_SUPABASE_PUBLISHABLE_KEY": "@VITE_SUPABASE_PUBLISHABLE_KEY",
    "ANTHROPIC_API_KEY": "@ANTHROPIC_API_KEY"
  }
}
